# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
# Path to the SQLite file. Created automatically on first run/migration.
DATABASE_PATH=./database/ikoct.db

# --- Auth ---
# Long, random, unguessable string. Generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- CORS ---
# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000

# --- First super-admin bootstrap (used only by `npm run seed`) ---
SEED_ADMIN_NAME=IKOCT Administrator
SEED_ADMIN_EMAIL=admin@ikoct.org
SEED_ADMIN_PASSWORD=change-this-immediately

# --- Payments (fill in when ready — never hard-code these anywhere) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- File uploads ---
MAX_UPLOAD_MB=5
UPLOAD_DIR=./uploads
